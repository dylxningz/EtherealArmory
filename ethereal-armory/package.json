{
  "name": "ethereal-armory",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "portfolio:manifest": "node scripts/build-portfolio-manifest.js",
    "predev": "npm run portfolio:manifest",
    "dev": "vite",
    "prebuild": "npm run portfolio:manifest",
    "build": "vite build",
    "postbuild": "node scripts/prune-invalid-portfolio.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "npm run test:unit && npm run test:e2e",
    "pretest:unit": "npm run portfolio:manifest",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.18.1",
    "resend": "^6.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.61.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "axe-core": "^4.12.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "vite": "^8.0.1"
  }
}
